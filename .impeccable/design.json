      "description": "A quiet utility action.",
      "html": "<button class=\"ds-button-ghost\" type=\"button\">Close</button>",
      "css": ".ds-button-ghost{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:7px 12px;border:1px solid var(--line,#d9d3e2);border-radius:6px;font-size:13px;font-weight:600;white-space:nowrap;cursor:pointer;font-family:\"Segoe UI\",\"Helvetica Neue\",sans-serif;background:transparent;color:var(--ink,#302739);border-color:transparent;transition:background .12s}.ds-button-ghost:hover:not(:disabled){background:var(--surface-soft,#f0edf5)}.ds-button-ghost:focus-visible{outline:2px solid var(--accent,#6941b5);outline-offset:3px}.ds-button-ghost:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-ghost{transition:none}}"
    },
    {
      "name": "Labeled input",
      "kind": "input",
      "refersTo": "input",
      "description": "A persistent label with associated hint or error.",
      "html": "<div class=\"ds-field\"><label for=\"ds-project-name\">Project name</label><input id=\"ds-project-name\" placeholder=\"Project name\" aria-describedby=\"ds-project-help\"><small id=\"ds-project-help\">Choose a recognizable name.</small></div>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;color:var(--ink,#302739);font-family:\"Segoe UI\",\"Helvetica Neue\",sans-serif;}.ds-field label{font-size:13px;font-weight:550}.ds-field input{min-height:38px;padding:8px 10px;border:1px solid var(--control-border,#8b7d98);border-radius:6px;background:var(--surface,#fff);color:var(--ink,#302739);font-size:14px;font-family:\"Segoe UI\",\"Helvetica Neue\",sans-serif;}.ds-field input::placeholder{color:var(--muted,#665b75);opacity:1}.ds-field input:focus-visible{outline:2px solid var(--accent,#6941b5);outline-offset:3px}.ds-field input[aria-invalid=true]{border-color:var(--danger,#b42335)}.ds-field small{font-size:12px;color:var(--muted,#665b75)}"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Permanent plum navigation with full-contrast current destination.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Preview navigation\"><a href=\"#projects\">Projects</a><a href=\"#issues\" aria-current=\"page\">Issues</a><a href=\"#sessions\">Sessions</a></nav>",
      "css": ".ds-nav{--surface:#2b2338;--surface-soft:#3e314f;--ink:#faf7ff;--muted:#cfc2df;--line:#665574;--accent:#d3bbff;--accent-soft:#493560;display:flex;flex-direction:column;gap:4px;width:188px;padding:16px;background:var(--surface);font-family:\"Segoe UI\",\"Helvetica Neue\",sans-serif;}.ds-nav a{display:flex;padding:10px 12px;border-radius:6px;font-size:14px;font-weight:550;text-decoration:none;color:var(--muted)}.ds-nav a:hover{background:var(--surface-soft);color:var(--ink)}.ds-nav a[aria-current=page]{background:var(--accent-soft);color:var(--ink)}.ds-nav a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}"
    },
    {
      "name": "Status badges",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Compact severity text on a quiet neutral fill.",
      "html": "<div class=\"ds-badges\"><span class=\"ds-badge\">Active</span><span class=\"ds-badge ds-error\">Error</span><span class=\"ds-badge ds-success\">Resolved</span></div>",
      "css": ".ds-badges{display:flex;gap:8px;flex-wrap:wrap;font-family:\"Segoe UI\",\"Helvetica Neue\",sans-serif;}.ds-badge{display:inline-flex;padding:2px 8px;background:var(--surface-soft,#f0edf5);color:var(--muted,#665b75);border-radius:4px;font-size:12px;font-weight:600;white-space:nowrap}.ds-error{color:var(--danger,#b42335)}.ds-success{color:var(--success,#19633e)}"
    },
    {
      "name": "Content card",
      "kind": "card",
      "refersTo": "card",
      "description": "A bordered flat grouping for related content.",
      "html": "<section class=\"ds-card\"><h2>Project activity</h2><p>Recorded errors and sessions appear here.</p></section>",
      "css": ".ds-card{padding:22px;border:1px solid var(--line,#d9d3e2);border-radius:7px;background:var(--surface,#fff);color:var(--ink,#302739);font-family:\"Segoe UI\",\"Helvetica Neue\",sans-serif;}.ds-card h2{margin:0;font-size:17px;font-weight:650}.ds-card p{margin:6px 0 0;font-size:14px;line-height:1.55;color:var(--muted,#665b75)}"
    },
    {
      "name": "Section tabs",
      "kind": "nav",
      "refersTo": "tabs",
      "description": "Selected sections use a violet underline; production tabs support arrow-key selection.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Preview sections\"><button role=\"tab\" aria-selected=\"true\">General</button><button role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Members</button><button role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Data</button></div>",
      "css": ".ds-tabs{display:flex;gap:6px;overflow-x:auto;border-bottom:1px solid var(--line,#d9d3e2)}.ds-tabs button{padding:12px;border:0;border-bottom:2px solid transparent;background:transparent;color:var(--muted,#665b75);font-size:14px;white-space:nowrap;cursor:pointer;font-family:\"Segoe UI\",\"Helvetica Neue\",sans-serif;}.ds-tabs button[aria-selected=true]{color:var(--accent,#6941b5);border-bottom-color:var(--accent,#6941b5);font-weight:650}.ds-tabs button:focus-visible{outline:2px solid var(--accent,#6941b5);outline-offset:3px}"
    },
    {
      "name": "Evidence disclosure",
      "kind": "custom",
      "refersTo": "evidence-section",
      "description": "Native disclosure groups recorded event evidence in a bordered panel.",
      "html": "<div class=\"ds-evidence\"><details class=\"ds-disclosure\" open><summary><h2>Stack trace</h2></summary><div class=\"ds-evidence-content\"><p>Event frames and error details appear here when recorded.</p></div></details><details class=\"ds-disclosure\"><summary><h2>Breadcrumbs</h2></summary><div class=\"ds-evidence-content\"><p>Recorded messages and categories appear here.</p></div></details></div>",
      "css": ".ds-evidence{background:var(--surface,#fff);color:var(--ink,#302739);border:1px solid var(--line,#d9d3e2);border-radius:7px;font-family:\"Segoe UI\",\"Helvetica Neue\",sans-serif;}.ds-disclosure+.ds-disclosure{border-top:1px solid var(--line,#d9d3e2)}.ds-disclosure>summary{display:flex;align-items:center;gap:10px;padding:18px 20px;list-style:none;cursor:pointer}.ds-disclosure>summary::-webkit-details-marker{display:none}.ds-disclosure>summary::after{content:'⌄';margin-left:auto}.ds-disclosure:not([open])>summary::after{content:'›'}.ds-disclosure h2{margin:0;font-size:17px;font-weight:650}.ds-disclosure>summary:focus-visible{outline:2px solid var(--accent,#6941b5);outline-offset:3px}.ds-evidence-content{padding:0 20px 20px;font-size:14px;line-height:1.55}.ds-evidence-content p{margin:0;color:var(--muted,#665b75)}@media(max-width:600px){.ds-disclosure>summary{padding:14px}.ds-evidence-content{padding:0 14px 14px}}"
    }
  ],
  "narrative": {
    "northStar": "Evidence-first developer triage",
    "overview": "replayd is a compact, calm workbench for following recorded evidence. Permanent plum navigation anchors neutral surfaces, violet actions and restrained severity colors. Familiar Sentry-like sidebar navigation, project cards, tables and grouped evidence panels express the owner's chosen developer-tool conventions.\n\nThe interface introduces the issue and its impact before resolution controls, then leads into event evidence and replay. A persistent workspace frame establishes location; evidence occupies the main column while a separate rail carries issue context. Settings, account and standalone error screens share the same typography, controls and theme behavior. The visual authority is the built dashboard, especially `dashboard/app/assets/css/main.css`, its shared UI components and layout; product purpose is recorded in `PRODUCT.md`.",
    "keyCharacteristics": [
      "Compact, readable information density.",
      "Plum navigation and neutral surfaces with subtle borders.",
      "Violet actions and explicit semantic severity.",
      "Evidence first, with progressively disclosed detail and a separate context rail.",
      "System typography and conventional controls.",
      "Equivalent light and dark themes."
    ],
    "rules": [
      {
        "name": "The Paired Theme Rule",
        "body": "Change text, backgrounds and borders together through semantic tokens. Shared primary buttons use white text in light mode and dark canvas text in dark mode; inspect both states rather than assuming a text utility remains readable. The sidebar keeps its own contrasting plum palette in either theme.",
        "section": "colors"
      },
      {
        "name": "The Overlay Depth Rule",
        "body": "Use a shadow to identify a surface above the current task, not to decorate each content card.",
        "section": "elevation"
      },
      {
        "name": "The Evidence and Context Rule",
        "body": "Establish issue identity and impact before workflow actions, then keep event evidence distinct from issue-level context. Use progressive disclosure to organize recorded detail without inventing unsupported features.",
        "section": "components"
      }
    ],
    "dos": [
      "Do reuse semantic tokens and shared controls across triage, replay, settings and account screens.",
      "Do inspect text, borders, icons and surfaces together in both themes.",
      "Do preserve readable table values with local scrolling and persistent headings.",
      "Do keep keyboard focus visible and actions reachable through native controls.",
      "Do use actual recorded activity and explicit loading, empty and error states.",
      "Do preserve the owner's Sentry-like conventions while exposing only replayd's real capabilities and permissions.",
      "Do check desktop, intermediate and mobile layouts with real pointer and keyboard interactions."
    ],
    "donts": [
      "Don't introduce a new accent or display font for a single screen.",
      "Don't apply content-card shadows as general decoration.",
      "Don't leave an offscreen navigation panel focusable when closed.",
      "Don't hardcode sample business records into the interface.",
      "Don't treat clipped controls, stale sort indicators or unreachable actions as design conventions."
    ]
  }
}
