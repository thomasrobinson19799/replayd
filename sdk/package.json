{
  "name": "replayd-sdk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "lint": "node scripts/check-core-deps.mjs && eslint . && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "size": "pnpm build && size-limit",
    "bench": "pnpm --filter @replayd/bench run bench"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@size-limit/file": "14.3.0",
    "@types/node": "22.19.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.4",
    "size-limit": "14.3.0",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "@rrweb/record@2.2.0": "patches/@rrweb__record@2.2.0.patch"
    }
  }
}
